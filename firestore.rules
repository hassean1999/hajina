rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signed() { return request.auth != null; }

    // Balances are written only by Cloud Functions / Admin. Clients can read
    // their own doc and edit profile fields only.
    match /users/{uid} {
      allow read: if signed();
      allow create: if signed() && request.auth.uid == uid;
      allow update: if signed() && request.auth.uid == uid
        && !request.resource.data.diff(resource.data).affectedKeys()
            .hasAny(['diamonds','silver','charm','withdrawn','pendingW','bag']);
    }
    match /rooms/{rid} {
      allow read, create: if signed();
      allow update: if signed() && resource.data.ownerUid == request.auth.uid;
      match /messages/{m} {
        allow read: if signed();
        // gift messages are written by Cloud Functions only
        allow create: if signed() && request.resource.data.uid == request.auth.uid
          && request.resource.data.type == 'text';
      }
    }
    // Withdrawals (created by the requestWithdraw function): create-only by the owner, pending only.
    match /withdrawals/{id} {
      allow read: if signed() && resource.data.uid == request.auth.uid;
    }
  }
}
