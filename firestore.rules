rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signed() { return request.auth != null; }

    function isAdmin() {
      return signed() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('admin', false) == true;
    }

    match /users/{uid} {
      allow read: if signed();
      allow create: if signed() && request.auth.uid == uid
        && !('admin' in request.resource.data) && request.resource.data.get('diamonds', 0) <= 0
        && request.resource.data.get('silver', 0) <= 100;
      allow update: if isAdmin()
        || (signed() && request.auth.uid == uid
            && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['admin', 'charm', 'followers', 'recharged'])
            && request.resource.data.get('diamonds', 0) <= resource.data.get('diamonds', 0)
            && (request.resource.data.get('silver', 0) <= resource.data.get('silver', 0)
                || (request.resource.data.get('silver', 0) <= resource.data.get('silver', 0) + 100
                    && request.resource.data.lastCheckin != resource.data.lastCheckin)))
        || (signed() && request.auth.uid != uid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['charm', 'followers', 'gw']));
      match /notifs/{n} {
        allow create: if signed();
        allow read, update, delete: if signed() && request.auth.uid == uid;
      }
      match /favRooms/{rid} {
        allow read, write: if signed() && request.auth.uid == uid;
      }
      match /following/{other} {
        allow read: if signed();
        allow write: if signed() && request.auth.uid == uid;
      }
    }

    match /rooms/{rid} {
      allow read, create, update: if signed();
      allow delete: if signed() && resource.data.ownerUid == request.auth.uid;
      match /members/{m} { allow read, write: if signed(); }
      match /messages/{msg} {
        allow read: if signed();
        allow create: if signed() && request.resource.data.uid == request.auth.uid;
      }
    }

    match /chats/{cid} {
      allow read: if signed() && (resource == null || request.auth.uid in resource.data.members);
      allow create, update: if signed() && cid.split('_').hasAny([request.auth.uid]);
      match /messages/{m} {
        allow read: if signed() && cid.split('_').hasAny([request.auth.uid]);
        allow create: if signed() && request.resource.data.uid == request.auth.uid && cid.split('_').hasAny([request.auth.uid]);
      }
    }

    match /reports/{r} { allow create: if signed(); }
    match /recharges/{x} { allow read, create: if isAdmin(); }
    match /families/{f} {
      allow read: if signed();
      allow create: if signed() && request.resource.data.owner == request.auth.uid;
      allow update: if signed();
      allow delete: if signed() && resource.data.owner == request.auth.uid;
    }
    match /events/{e} {
      allow read: if signed();
      allow write: if isAdmin();
    }
    match /posts/{pid} {
      allow read: if signed();
      allow create: if signed() && request.resource.data.u.uid == request.auth.uid;
      allow update: if signed();
      allow delete: if signed() && (resource.data.u.uid == request.auth.uid || isAdmin());
      match /comments/{c} {
        allow read: if signed();
        allow create: if signed() && request.resource.data.u.uid == request.auth.uid;
      }
    }
    match /games/{g} { allow read, create, update: if signed(); }
    match /avatars/{uid} {
      allow read: if signed();
      allow write: if signed() && request.auth.uid == uid
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('recharged', 0) >= 5000;
    }
    match /roomMedia/{m} {
      allow read: if signed();
      allow write: if signed() && request.resource.data.owner == request.auth.uid
        && (resource == null || resource.data.owner == request.auth.uid);
    }
  }
}
